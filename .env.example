# Copy to .env and edit. Relative paths are resolved against the project root.
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
MODEL_DIR=models
REPORT_DIR=reports
METRICS_CONFIG_PATH=configs/metrics.toml

LOG_LEVEL=WARNING            # console level; the log file always records INFO

# Chronological split: earliest TRAIN_FRACTION of rows -> train, the rest -> test
TRAIN_FRACTION=0.7

# Max consecutive missing samples repaired by forward-fill (4 x 15 s = 1 min)
MAX_FFILL_STEPS=4
# error | first | last | mean
DUPLICATE_POLICY=error

# Features given to the model (JSON list). See README: redundant columns are excluded.
MODEL_FEATURES=["cpu_usage","memory_usage","response_time_a","response_time_b"]

# Isolation Forest hyper-parameters
IF_N_ESTIMATORS=200
IF_CONTAMINATION=0.05
IF_MAX_SAMPLES=auto
IF_RANDOM_STATE=42
